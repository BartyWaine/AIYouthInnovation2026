# Example environment configuration
# Copy this file to .env and fill in real values before running.
# NEVER commit the real .env file.

# ── Backend ──────────────────────────────────────────────
# Development (SQLite — no server needed):
DATABASE_URL=sqlite:///./test.db

# Production (PostgreSQL — required for production):
# DATABASE_URL=postgresql://user:password@localhost:5432/competition

# JWT — generate a strong random key (REQUIRED in production):
#   python -c "import secrets; print(secrets.token_hex(32))"
# In development, a weak fallback is used with a warning.
JWT_SECRET=dev-secret-change-me

# Environment mode — set to "production" in deployment:
ENVIRONMENT=development

# CORS origins — comma-separated list of allowed frontend origins:
# CORS_ORIGINS=http://localhost:3000,http://your-domain.com

# OpenAI API key (optional, for future AI validation features):
OPENAI_API_KEY=

# ── Frontend ────────────────────────────────────────────
# Base URL the Vite dev server proxies /api to in development.
# In production, this is typically the same origin.
VITE_API_URL=http://localhost:8022

# ── PostgreSQL (docker-compose) ─────────────────────────
# Change these before deploying:
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
POSTGRES_DB=competition_db
