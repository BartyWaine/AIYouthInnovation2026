# Example environment configuration
# Copy this file to .env and fill in real values before running.
# NEVER commit the real .env file.

# ── Backend ──────────────────────────────────────────────
# Development (SQLite — no server needed):
DATABASE_URL=sqlite:///./test.db

# Production (PostgreSQL — required for production):
# DATABASE_URL=postgresql://user:password@localhost:5432/competition

# JWT — generate a strong random key (REQUIRED in production):
#   python -c "import secrets; print(secrets.token_hex(32))"
# In development, a weak fallback is used with a warning.
JWT_SECRET=dev-secret-change-me

# Environment mode — set to "production" in deployment:
ENVIRONMENT=development

# ── Rate limiting ────────────────────────────────────────
# Worker count — keep at 1 until shared Redis rate-limit storage is verified.
# Deployment-specific: change only as part of an approved scaling change.
WEB_CONCURRENCY=1

# Rate limiting backend — use redis:// for production deployments:
#   Development (single-process, in-memory): RATE_LIMIT_STORAGE=memory://
#   Production (multi-worker, Kubernetes, docker-compose): RATE_LIMIT_STORAGE=redis://redis:6379/0
# If unset, defaults to memory:// (suitable for dev only).
# WARNING: In production, memory:// with more than one worker will fail at startup.
# Deployment-specific: set via your secrets manager or deployment pipeline.
RATE_LIMIT_STORAGE=memory://

# Per-endpoint rate limits (requests per minute).
# Omit or leave empty to use the default ("5/minute").
# Format: <number> or <number>/minute or <number>/hour
# RATE_LIMIT_LOGIN=5/minute
# RATE_LIMIT_CHANGE_PASSWORD=5/minute
# RATE_LIMIT_RESET_PASSWORD=5/minute
# RATE_LIMIT_UPLOAD=10/minute
# RATE_LIMIT_CORRECT_SCORE=5/minute
# RATE_LIMIT_EVAL_STATUS=5/minute
# RATE_LIMIT_CREATE_DELIVERABLE=5/minute

# CORS origins — comma-separated list of allowed frontend origins:
# CORS_ORIGINS=http://localhost:3000,http://your-domain.com

# OpenAI API key (optional, for future AI validation features):
OPENAI_API_KEY=

# ── Frontend ────────────────────────────────────────────
# Base URL the Vite dev server proxies /api to in development.
# In production, this is typically the same origin.
VITE_API_URL=http://localhost:8022

# ── PostgreSQL (docker-compose) ─────────────────────────
# Change these before deploying:
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
POSTGRES_DB=competition_db
