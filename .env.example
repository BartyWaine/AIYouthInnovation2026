# Example environment configuration
# Copy this file to .env and fill in real values before running.
# NEVER commit the real .env file.

# ── Backend ──────────────────────────────────────────────
# Development (SQLite — no server needed):
DATABASE_URL=sqlite:///./test.db

# Production (PostgreSQL):
# DATABASE_URL=postgresql://user:password@localhost:5432/competition

# JWT — generate a strong random key:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-secret-change-me

# OpenAI API key (optional, for future AI validation features)
OPENAI_API_KEY=

# ── Frontend ────────────────────────────────────────────
# Base URL the Vite dev server proxies /api to in development.
# In production, this is typically the same origin.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8022
